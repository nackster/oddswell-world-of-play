    {
      "id": "a100000000000004",
      "type": "text",
      "text": "# 🧠 Project Brain\n\n⭐ **OBSIDIAN**\n\nPlans, decisions, standards, research, prompts, evaluations, and architecture history.",
      "x": -1530,
      "y": -480,
