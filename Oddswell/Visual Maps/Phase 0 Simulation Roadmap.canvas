    {"id":"p0-5t","type":"text","text":"## 0.5T ✅ RECENT PERFORMANCE REVIEW\nOne previous-game scoring signal • chronology-safe same-season baseline\n211 response states • 93 one-step changes • v3 remains default • $0","x":-650,"y":4330,"width":1360,"height":150,"color":"3"},
