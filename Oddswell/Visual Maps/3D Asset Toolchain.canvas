		{"id":"asset-stage3-card","type":"text","text":"## Clean and standardize\nModel or retopologize; set scale, UVs, materials, naming, pivots, collision, and LODs. Generated meshes are inputs, not final assets.","x":180,"y":-55,"width":450,"height":140,"color":"3"},
