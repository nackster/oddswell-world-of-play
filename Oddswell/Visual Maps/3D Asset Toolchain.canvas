		{"id":"asset-stage1-card","type":"text","text":"## Approve the reference set\nUse Higgsfield for consistent turnarounds, expressions, clothing, props, and presentation frames. Lock style before modeling.","x":60,"y":-600,"width":570,"height":140,"color":"5"},
